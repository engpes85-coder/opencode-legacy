+// OPENCODE_LOWEND picks the level: unset means 1 on Windows 7/8/8.1 (NT 6.x) and 0 elsewhere.
+//   0 = off
+//   1 = lighter Chromium: low-end memory mode, no smooth scrolling, no background network chatter, 2 renderers
+//   2 = level 1 plus a single renderer and no site isolation. Saves the most memory; only use it if the app
+//       never opens untrusted websites.
+// OPENCODE_DISABLE_GPU=1 turns off hardware acceleration for machines whose old drivers crash the GPU process.
+function applyLowEndSwitches() {
+  const legacyWindows = process.platform === "win32" && Number.parseInt(release().split(".")[0] ?? "10", 10) < 10
+  const level = process.env.OPENCODE_LOWEND ?? (legacyWindows ? "1" : "0")
+  if (process.env.OPENCODE_DISABLE_GPU === "1") app.disableHardwareAcceleration()
+  if (level !== "1" && level !== "2") return
+  const disabled = [
+    "CalculateNativeWinOcclusion",
+    "HardwareMediaKeyHandling",
+    "Translate",
+    "MediaRouter",
+    "OptimizationHints",
+    "AutofillServerCommunication",
+  ]
+  app.commandLine.appendSwitch("disable-smooth-scrolling")
+  app.commandLine.appendSwitch("enable-low-end-device-mode")
+  app.commandLine.appendSwitch("disable-background-networking")
+  app.commandLine.appendSwitch("disable-sync")
+  app.commandLine.appendSwitch("no-pings")
+  if (level === "2") {
+    disabled.push("IsolateOrigins", "site-per-process")
+    app.commandLine.appendSwitch("disable-site-isolation-trials")
+    app.commandLine.appendSwitch("renderer-process-limit", "1")
+  } else app.commandLine.appendSwitch("renderer-process-limit", "2")
+  app.commandLine.appendSwitch("disable-features", disabled.join(","))
+}
