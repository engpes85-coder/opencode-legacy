+
+// Windows 7/8/8.1 (NT 6.x) PCs and anything started with OPENCODE_LOWEND=1 get a lighter Chromium:
+// fewer renderer processes, no smooth-scroll animation, low-end memory mode. OPENCODE_DISABLE_GPU=1 turns
+// off hardware acceleration for machines whose old graphics drivers crash the GPU process.
+function applyLowEndSwitches() {
+  const legacyWindows = process.platform === "win32" && Number.parseInt(release().split(".")[0] ?? "10", 10) < 10
+  const lowEnd = legacyWindows || process.env.OPENCODE_LOWEND === "1"
+  if (process.env.OPENCODE_DISABLE_GPU === "1") app.disableHardwareAcceleration()
+  if (!lowEnd || process.env.OPENCODE_LOWEND === "0") return
+  app.commandLine.appendSwitch("disable-smooth-scrolling")
+  app.commandLine.appendSwitch("enable-low-end-device-mode")
+  app.commandLine.appendSwitch("renderer-process-limit", "2")
+  app.commandLine.appendSwitch("disable-features", "CalculateNativeWinOcclusion,HardwareMediaKeyHandling")
+}
