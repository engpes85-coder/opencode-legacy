diff --git a/packages/gui-plugins/src/updater/legacy-platform.ts b/packages/gui-plugins/src/updater/legacy-platform.ts
new file mode 100644
index 0000000..811b69c
--- /dev/null
+++ b/packages/gui-plugins/src/updater/legacy-platform.ts
@@ -0,0 +1,63 @@
+import { existsSync, readFileSync } from "node:fs"
+import { join } from "node:path"
+import { app, net, shell } from "electron"
+import { Effect } from "effect"
+import type { Platform } from "./machine"
+
+// Update source for the Windows 7/8/8.1 build: the GitHub releases of the fork that publishes it.
+const RELEASES_API = "https://api.github.com/repos/engpes85-coder/opencode-legacy/releases?per_page=10"
+const RELEASES_PREFIX = "https://github.com/engpes85-coder/opencode-legacy/"
+
+/** True for the legacy Windows build, which ships its server runtime in resources/win7. */
+export function legacyBuild() {
+  return (
+    process.platform === "win32" &&
+    app.isPackaged &&
+    existsSync(join(process.resourcesPath, "win7", "server", "opencode.mjs"))
+  )
+}
+
+// The release workflow writes the tag it publishes (for example v2.3.1-win788.2) next to the server bundle.
+function installedTag() {
+  try {
+    const tag = readFileSync(join(process.resourcesPath, "win7", "release-tag.txt"), "utf8").trim()
+    if (tag) return tag
+  } catch {}
+  return `v${app.getVersion()}-win788.0`
+}
+
+const numbers = (tag: string) => (tag.match(/\d+/g) ?? []).map(Number)
+
+function compare(a: number[], b: number[]) {
+  for (let i = 0; i < Math.max(a.length, b.length); i++) {
+    const diff = (a[i] ?? 0) - (b[i] ?? 0)
+    if (diff !== 0) return diff
+  }
+  return 0
+}
+
+export const make = Effect.fn("Updater.legacyPlatform")(function* () {
+  return {
+    checkForUpdate: Effect.tryPromise({
+      try: async () => {
+        const response = await net.fetch(RELEASES_API, {
+          headers: { Accept: "application/vnd.github+json", "User-Agent": `opencode-legacy/${app.getVersion()}` },
+        })
+        if (!response.ok) throw new Error(`GitHub answered ${response.status}`)
+        const releases = (await response.json()) as Array<{ tag_name: string; draft: boolean; html_url: string }>
+        const latest = releases.find((release) => !release.draft && /^v\d/.test(release.tag_name))
+        if (!latest || compare(numbers(latest.tag_name), numbers(installedTag())) <= 0) return undefined
+
+        return { mode: "external", version: latest.tag_name.replace(/^v/, ""), url: latest.html_url } as const
+      },
+      catch: (error) => error,
+    }),
+    // Nothing is downloaded or installed in place: the person downloads the new portable zip themselves.
+    stageUpdate: () => Effect.void,
+    installAndRestart: Effect.void,
+    externalInstall: (url: string) =>
+      url.startsWith(RELEASES_PREFIX)
+        ? Effect.tryPromise({ try: () => shell.openExternal(url), catch: (error) => error })
+        : Effect.fail(new Error("Refusing to open a link outside the release page")),
+  } satisfies Platform
+})
